# FITX local-development environment
# Copy this file to .env. Never use these example values in production.

COMPOSE_PROJECT_NAME=fitx
FRONTEND_PORT=3000
API_PORT=8080
SQLSERVER_PORT=1433

# Container/runtime versions. Match DOTNET_VERSION to FITX.API's TargetFramework.
NODE_VERSION=22
DOTNET_VERSION=9.0

# SQL Server
SQLSERVER_DATABASE=FITX
SQLSERVER_SA_PASSWORD=ChangeMe_SQL_2026!

# Public browser URL and the server-side URL used inside the Compose network
NEXT_PUBLIC_API_URL=http://localhost:8080/api
INTERNAL_API_BASE_URL=http://api:8080/api
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Authentication -- replace JWT_SECRET with at least 32 random bytes.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=FITX.API
JWT_AUDIENCE=FITX.Web
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
JWT_REMEMBER_ME_REFRESH_TOKEN_DAYS=30

# Gym/localization defaults
DEFAULT_LOCALE=en
GYM_DEFAULT_CURRENCY=PKR
GYM_DEFAULT_TIMEZONE=Asia/Karachi
MEMBERSHIP_EXPIRING_SOON_DAYS=7

# Local-only migration and seed switches
APPLY_MIGRATIONS=true
SEED_DEMO_DATA=true
SEED_DEVELOPMENT_ADMIN=true
DEVELOPMENT_ADMIN_EMAIL=admin@fitx.local
DEVELOPMENT_ADMIN_PASSWORD=Fitx@123

# Reminder delivery. Mock records Mocked logs and never claims external delivery.
REMINDER_PROVIDER_MODE=Mock
EMAIL_PROVIDER=Mock
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
SMS_PROVIDER=Mock
SMS_API_KEY=
SMS_SENDER_ID=
WHATSAPP_PROVIDER=Mock
WHATSAPP_API_KEY=
WHATSAPP_SENDER_ID=
